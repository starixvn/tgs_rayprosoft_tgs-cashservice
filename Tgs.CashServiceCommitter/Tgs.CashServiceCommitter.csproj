<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SqlQueryToolsConnectionString />
    <UserSecretsId>87510c54-ca86-466e-b3f0-d122ca36cd79</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <ContainerRepository>cash/committer</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.3.8" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.20.1" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="8.0.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.8.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.8.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.8.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.8.1" />
    <PackageReference Include="PhoenixToolkits.CodeAnalysis.Analyzers" Version="0.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PhoenixToolkits.MessageQueue.Nats" Version="2.2.0" />
    <PackageReference Include="Polly" Version="8.4.0" />
    <PackageReference Include="ProfileViewer.OpenTelemetry.Exporter" Version="0.3.1" />
    <PackageReference Include="Tgs.MessageQueue.Nats.Serializers" Version="0.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tgs.CashServiceCommitter.Core\Tgs.CashServiceCommitter.Core.csproj" />
    <ProjectReference Include="..\Tgs.CashServiceCommitter.Repositories\Tgs.CashServiceCommitter.Repositories.csproj" />
  </ItemGroup>

</Project>
